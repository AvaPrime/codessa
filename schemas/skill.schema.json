{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AvaPrime/codessa/schemas/skill.schema.json",
  "title": "Skill",
  "description": "Versioned instructions. Content is not capability and not authority.",
  "type": "object",
  "required": ["skill_id", "version", "content_hash", "approval_ref", "grants_authority"],
  "properties": {
    "skill_id": {"type": "string"},
    "version": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "approval_ref": {"type": "string"},
    "grants_authority": {"const": false}
  },
  "additionalProperties": false
}
