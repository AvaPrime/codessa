{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AvaPrime/codessa/schemas/memory.schema.json",
  "title": "Memory",
  "description": "Persisted contextual experience. Promotion is not canonical truth.",
  "type": "object",
  "required": ["memory_id", "content", "epistemic_status", "lifecycle", "derived_from", "scope"],
  "properties": {
    "memory_id": {"type": "string"},
    "content": {"type": "string"},
    "epistemic_status": {"enum": ["PROVISIONAL", "OBSERVED", "INFERRED", "VALIDATED", "REJECTED"]},
    "lifecycle": {"enum": ["EXTRACTED", "CANDIDATE", "PROMOTED", "QUARANTINED", "SUPERSEDED", "ARCHIVED"]},
    "derived_from": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scope": {"type": "string"},
    "valid_from": {"type": "string"},
    "valid_until": {"type": ["string", "null"]}
  },
  "not": {"required": ["epistemic_status"], "properties": {"epistemic_status": {"const": "CANONICAL"}}},
  "additionalProperties": false
}
