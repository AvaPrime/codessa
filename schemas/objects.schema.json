{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codessa.local/schemas/context-objects.proposed.json",
  "title": "Codessa context objects (proposed)",
  "description": "Proposal only. Not a canonical Codessa schema.",
  "type": "object",
  "properties": {
    "resource": {
      "type": "object",
      "required": ["resource_id", "provider", "locator", "revision", "content_hash", "lifecycle"],
      "properties": {
        "resource_id": {"type": "string"},
        "provider": {"type": "string"},
        "locator": {"type": "string"},
        "revision": {"type": "string"},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "lifecycle": {"enum": ["DISCOVERED", "INGESTED", "INDEXED", "AVAILABLE", "SUPERSEDED", "ARCHIVED"]}
      }
    },
    "memory": {
      "type": "object",
      "required": ["memory_id", "content", "epistemic_status", "lifecycle", "derived_from"],
      "properties": {
        "memory_id": {"type": "string"},
        "content": {"type": "string"},
        "epistemic_status": {"enum": ["PROVISIONAL", "OBSERVED", "INFERRED", "VALIDATED", "REJECTED"]},
        "lifecycle": {"enum": ["EXTRACTED", "CANDIDATE", "PROMOTED", "QUARANTINED", "SUPERSEDED", "ARCHIVED"]},
        "derived_from": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "skill": {
      "type": "object",
      "required": ["skill_id", "version", "content_hash", "approval_ref"],
      "properties": {
        "skill_id": {"type": "string"},
        "version": {"type": "string"},
        "content_hash": {"type": "string"},
        "approval_ref": {"type": "string"},
        "grants_authority": {"const": false}
      }
    }
  }
}
