{
  "name": "codessa",
  "version": "1.0.0-phase-iv-final",
  "description": "Distributed Multi-Agent Reasoning System",
  "main": "core/codessa-kernel.ts",
  "private": true,
  "workspaces": [
    "bootstrap",
    "operator-agent",
    "fallback",
    "shared"
  ],
  "scripts": {
    "start": "node core/codessa-kernel.js",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:meta": "jest src/__tests__/meta --coverage --config=src/__tests__/meta/jest.config.js",
    "test:meta:watch": "jest src/__tests__/meta --watch --config=src/__tests__/meta/jest.config.js",
    "test:meta:debug": "jest src/__tests__/meta --verbose --config=src/__tests__/meta/jest.config.js",
    "test:coverage:baseline": "COVERAGE_DIR=coverage-baseline jest --coverage",
    "test:coverage:new": "COVERAGE_DIR=coverage-new jest --coverage",
    "coverage:baseline": "node scripts/coverage-compare.js baseline",
    "coverage:new": "node scripts/coverage-compare.js new",
    "coverage:compare": "node scripts/coverage-compare.js compare",
    "coverage:clean": "node scripts/coverage-compare.js clean",
    "test:integration": "echo \"Running integration tests for Phase IV modules...\"",
    "test:performance": "echo \"Running performance tests...\"",
    "validate:system": "echo \"Validating system health and module integrity...\"",
    "activate:agents": "echo \"Activating DirectiveTrackerAgent and SystemStateUpdater...\"",
    "phase:finalize": "echo \"Finalizing Phase IV and preparing for Phase V...\"",
    "api-manager": "ts-node src/main.ts",
    "prompt": "ts-node src/cli/promptCli.ts",
    "orchestration:demo": "ts-node src/demos/demoOrchestration.ts",
    "orchestration:prompt": "ts-node src/demos/demoOrchestration.ts",
    "codexforge": "ts-node src/shell/codexForge.ts",
    "shell": "ts-node src/shell/codexForge.ts",
    "audit:refactor": "ts-node scripts/audit/run-all.ts",
    "audit:eslint": "ts-node scripts/audit/parse-eslint.ts",
    "audit:coverage": "ts-node scripts/audit/parse-coverage.ts",
    "audit:dependencies": "ts-node scripts/audit/dependency-diff.ts",
    "audit:build-report": "ts-node scripts/audit/build-report.ts",
    "build:workspaces": "npm run build --workspaces",
    "test:workspaces": "npm run test --workspaces",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "fix": "npm run lint && npm run format",
    "prepare": "husky install",
    "clean": "npm run clean --workspaces"
  },
  "keywords": [
    "ai",
    "multi-agent",
    "reasoning",
    "autonomous",
    "distributed"
  ],
  "author": "Codessa Development Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.13",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^4.3.0",
    "@google-cloud/firestore": "^7.11.2",
    "@google-cloud/secret-manager": "^6.1.0",
    "@google-cloud/storage": "^7.0.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.49.1",
    "@opentelemetry/exporter-prometheus": "^0.49.1",
    "@opentelemetry/instrumentation-express": "^0.34.1",
    "@opentelemetry/instrumentation-http": "^0.49.1",
    "@opentelemetry/sdk-node": "^0.49.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.33",
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "events": "^3.3.0",
    "express": "^4.21.2",
    "google-auth-library": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "winston": "^3.8.0",
    "winston-loki": "^6.1.3",
    "winston-transport": "^4.5.0",
    "ws": "^8.18.3",
    "yargs": "^18.0.0"
  }
}
